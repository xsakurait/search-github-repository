# GitHub API（リポジトリ検索用・任意）
GITHUB_TOKEN=""

# NextAuth（GitHub OAuth アプリの Client ID / Secret）
GITHUB_ID=""
GITHUB_SECRET=""
NEXTAUTH_SECRET=""
# 本番は https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# PostgreSQL（Supabase）
# 取得: Supabase ダッシュボード → Project Settings → Database → Connection string → URI
# [YOUR-PASSWORD] をプロジェクト作成時の DB パスワードに置き換える
#
# Prisma の db push / migrate には「Direct connection」（ポート 5432）を使う
# 例:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
#
# ※ ホスト名・リージョンは Supabase に表示された URI をそのままコピーすること
# DATABASE_URL は schema.prisma の env("DATABASE_URL") から参照される
# Next.js / Prisma 共通: .env または .env.local に書く（Prisma CLI は prisma.config.ts 経由で両方読む）
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
