# すべてのテキストファイルの改行コードを自動でLFに固定化（チェックアウト時にOS依存にせずLFのままにする）
* text=auto eol=lf

# 特定のファイルタイプに対する明示的な設定
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.env* text eol=lf
